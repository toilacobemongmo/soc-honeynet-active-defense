# ==============================================================================
# Mini-SOC Active Defense & SOAR Ecosystem - Environment Configuration
# ==============================================================================
# Sao chep file nay thanh .env va dien cac thong so cua ban (neu muon kich hoat live bot/API)
# cp .env.example .env

# Telegram SOAR Bot (Tuy chon - neu khong dien, he thong se chay che do Simulator console)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Threat Intelligence APIs (Tuy chon - de trong se dung fallback che do gia lap offline an toan)
ABUSEIPDB_API_KEY=
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=

# System Settings
ENVIRONMENT=development
HONEYPOT_PORT=2222
CANARY_PORT=8080
LOG_LEVEL=INFO
